# Copia este archivo como .env y cambia los valores. Nunca subas el .env al repositorio.

# Base de datos (los usa docker-compose y el backend)
POSTGRES_USER=checkin
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=checkin
DATABASE_URL=postgresql+psycopg://checkin:cambia-esta-clave@localhost:5432/checkin

# JWT: genera un valor largo y aleatorio, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=genera-un-secreto-largo-y-aleatorio
JWT_EXPIRE_MINUTES=60

# Origenes permitidos por CORS (separados por coma). Angular en desarrollo usa el 4200.
CORS_ORIGINS=http://localhost:4200
